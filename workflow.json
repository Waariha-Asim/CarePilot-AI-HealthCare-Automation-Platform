      "id": "0a3fc489-4208-4af6-85b8-7e59efb9052f",
      "name": "F1 — AI Patient Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [112, -80]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch(e) {\n  data = {\n    patient_id: 'CP-' + new Date().getFullYear() + '-' + String(Math.floor(Math.random() * 9000) + 1000),\n    name: $('CarePilot Webhook').item.json.body.data.full_name || 'Unknown',\n    age: $('CarePilot Webhook').item.json.body.data.age || 0,\n    gender: $('CarePilot Webhook').item.json.body.data.gender || 'Not provided',\n    contact: $('CarePilot Webhook').item.json.body.data.contact || 'Not provided',\n    key_health_notes: [],\n    record_status: 'created'\n  };\n}\n\ndata.patient_id = $('CarePilot Webhook').item.json.body.data.suggested_patient_id || \n  data.patient_id || \n  'CP-' + new Date().getFullYear() + '-' + String(Math.floor(Math.random() * 9000) + 1000);\ndata.name = data.name || $('CarePilot Webhook').item.json.body.data.full_name || 'Unknown';\ndata.record_status = data.record_status || 'created';\ndata.key_health_notes = data.key_health_notes || [];\n\nreturn [{ json: { ...data, timestamp: new Date().toISOString() } }];"
      },
