    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\n\nlet ai = {};\n\ntry {\n  ai = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (error) {\n  ai = {};\n}\n\nconst webhook = $('CarePilot Webhook').item.json.body.data;\n\nreturn [\n  {\n    json: {\n      appointment_id: $('CarePilot Webhook').item.json.body.data.suggested_appt_id || `APT-2026-${Date.now()}`,\n\n      patient_id: webhook.patient_id || '',\n      patient_name: webhook.patient_name || '',\n\n      department: ai.department || 'General Medicine',\n      priority: ai.priority || 'medium',\n      urgency_level: ai.urgency_level || 'normal',\n      recommended_action:\n        ai.recommended_action || 'Contact clinic for scheduling',\n      ai_notes:\n        ai.ai_notes || 'AI assessment completed',\n\n      date: webhook.preferred_date || '',\n      time: webhook.preferred_time || '',\n\n      status: 'Pending',\n      reminder_sent: 'false',\n      alert_sent: 'false',\n\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
