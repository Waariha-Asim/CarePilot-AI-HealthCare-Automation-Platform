        "jsonBody": "={\"model\":\"openai/gpt-oss-120b\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a healthcare records assistant. Extract patient information from the provided data. Return ONLY valid JSON with patient_id (format: CP-YYYY-XXXX), name, age, gender, contact, key_health_notes (array), record_status. Do not diagnose or add medical information that is not provided.\"},{\"role\":\"user\",\"content\":\"Patient Data: Name: {{$json.body.data.full_name}}, Age: {{$json.body.data.age}}, Gender: {{$json.body.data.gender}}, Contact: {{$json.body.data.contact}}, Email: {{$json.body.data.email}}, Medical History: {{$json.body.data.medical_history}}\"}],\"temperature\":0.1,\"response_format\":{\"type\":\"json_object\"}}",
